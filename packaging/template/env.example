# ============================================================================
# im1.0 环境变量模板 —— 复制成 .env 后按需修改
#
# ## 这份文件的每个名字都是**实测过的**，不是抄文档
#
# 事实来源：`AppConfig` 的字段名 + `crates/im-common/src/config.rs:315-321`
# 的转换规则 + 2026-10-06 用 release 二进制跑出来的真实行为。
#
# ## 规则只有一条：变量名去掉 `IM_` 前缀后小写，必须等于 `AppConfig` 的字段名
#
#   IM_POSTGRES_URL        -> postgres_url
#   IM_HTTP_PORT           -> http_port
#   IM_JWT_SIGNING_KEYS    -> jwt_signing_keys
#   IM_REFRESH_PEPPER      -> refresh_pepper
#   IM_EVENT_PUBLISHER     -> event_publisher   (注意：这是一个**嵌套结构**，
#                                                值必须是 JSON 对象，不是散开的两个变量)
#   IM_SERVER_SECRETS      -> server_secrets
#   IM_ACCESS_TOKEN_TTL_SECONDS  -> access_token_ttl_seconds
#
# ## 三个必须知道的实测结论
#
# 1. **不认识的 `IM_*` 变量会被静默忽略。** 实测：设一个完全虚构的
#    `IM_TOTALLY_BOGUS_KEY`，服务照常启动。所以「我配了」不等于「它生效了」。
#    用 `scripts/preflight.ps1` 验证，不要靠猜。
#
# 2. **下面 4 个变量是必填的**（`AppConfig` 里没有 `#[serde(default)]`）：
#    `IM_POSTGRES_URL` / `IM_JWT_SIGNING_KEYS` / `IM_REFRESH_PEPPER` /
#    `IM_EVENT_PUBLISHER`。少任何一个，服务启动即失败。
#
# 3. **配置出错时只会打印 `config load failed: internal error`**，
#    不会告诉你是哪个变量、也不会告诉你值哪里不对。**所以启动前先跑
#    preflight** —— 它会逐项告诉你哪儿不对，而且**不打印任何密钥值**。
#
# ## 下面这些名字是**错的**，本仓的历史文档里出现过，别用
#
#   IM_EVENT_PUBLISHER_KIND      ✗ 映射到不存在的字段。正确的是 IM_EVENT_PUBLISHER（整块 JSON）
#   IM_EVENT_PUBLISHER_NATS_URL  ✗ 同上
#   IM__JWT__SIGNING__KEYS       ✗ 双下划线是 figment 嵌套分隔符，本仓单层字段不用它
#   IM__REFRESH__PEPPER          ✗ 同上
#   IM_DATABASE_URL              ✗ 字段叫 postgres_url
#   DATABASE_URL                 ✗ 仅测试代码用，im-gateway 不读
#
# ============================================================================

# ---- 必填 1/4：PostgreSQL 连接串 ----
# 格式：postgres://user:password@host:port/dbname
IM_POSTGRES_URL=postgres://im:CHANGE_ME@127.0.0.1:5432/im1

# ---- 必填 2/4：JWT 签名密钥（JSON 数组，至少 1 项）----
# kid 是密钥标识，写进 token 头；轮换期可同时放 v1(active=true) + v2(active=false)。
# key 至少 32 字节随机串。**不要**提交这个文件。
IM_JWT_SIGNING_KEYS=[{"kid":"v1","key":"CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES","active":true}]

# ---- 必填 3/4：refresh token pepper ----
# 与 sha256 一起派生 device_session.refresh_token_hash。换个值会让所有已签发的
# refresh token 全部失效。
IM_REFRESH_PEPPER=CHANGE_ME

# ---- 必填 4/4：事件发布器（一个 JSON 对象）----
# kind=stub  : MVP 默认，不连 NATS，事件被**有意丢弃**（不是故障，/readyz 不会因此挂）
# kind=nats  : 连 JetStream，此时 nats_url 必填
IM_EVENT_PUBLISHER={"kind":"stub","nats_url":""}

# ---- 可选 ----
# HTTP 监听端口，默认 8080
IM_HTTP_PORT=8080

# S2S token exchange 用的 per-environment 签名密钥，JSON 对象 {"<env-uuid>":"secret"}。
# 不配则 S2S 接口不可用（其余功能不受影响）。
# IM_SERVER_SECRETS={}

# access token 有效期（秒），默认 900 = 15 分钟
# IM_ACCESS_TOKEN_TTL_SECONDS=900

# refresh token 有效期（秒），默认 2592000 = 30 天
# IM_REFRESH_TOKEN_TTL_SECONDS=2592000

# 单条消息最大字节数，默认 65536 = 64 KiB
# IM_MAX_MESSAGE_SIZE_BYTES=65536
