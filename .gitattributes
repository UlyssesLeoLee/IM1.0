# 自动检测文本文件并设置 LF
* text=auto eol=lf

# Shell 脚本
*.sh text eol=lf
*.bash text eol=lf

# Windows 批处理
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 文档
*.md text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Rust 源代码 (强制 LF)
*.rs text eol=lf
*.toml text eol=lf
